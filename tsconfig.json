{
  "include": ["lib/index.js"], 
  "compilerOptions": {
    "allowJs": true,           
    "declaration": true,       
    "emitDeclarationOnly": true, 
    "outDir": "types",         
    "module": "ESNext",      
    "target": "ESNext",        
    "moduleResolution": "node",
    "noUnusedLocals": false,
    "noUnusedParameters": false
  }
}
