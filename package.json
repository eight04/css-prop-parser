{
  "name": "css-prop-parser",
  "version": "0.1.0",
  "description": "A small library to parse CSS property strings. Can be useful to extract value from CSS properties without a full CSS parser.",
  "keywords": [
    "css",
    "parser",
    "property"
  ],
  "homepage": "https://github.com/eight04/css-prop-parser",
  "bugs": {
    "url": "https://github.com/eight04/css-prop-parser/issues",
    "email": "eight04@gmail.com"
  },
  "license": "MIT",
  "author": "eight <eight04@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eight04/css-prop-parser.git"
  },
  "devDependencies": {
    "dts-buddy": "^0.6.2",
    "eslint": "^9.20.1",
    "eslint-plugin-compat": "^6.0.2",
    "shx": "^0.4.0",
    "typescript": "5.8.x"
  },
  "scripts": {
    "test": "eslint . && node --test --test-reporter spec --test-reporter-destination stdout --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=lcov.info",
    "build-types": "shx rm -rf types/* && dts-buddy",
    "preversion": "npm test",
    "version": "npm run build-types && git add .",
    "postversion": "git push --follow-tags && npm publish"
  },
  "files": [
    "index.*",
    "dist",
    "lib",
    "types"
  ],
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "dependencies": {}
}
